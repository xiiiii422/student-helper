# 文本主模型（OpenAI 兼容接口，默认智谱 GLM 免费模型）
CHAT_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
CHAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CHAT_MODEL=glm-4.7-flash
CHAT_MAX_TOKENS=4000
# 多模态辅助模型（带图请求自动切换；KEY/URL 留空则复用主模型账号）
# 注意 glm-4v-flash 输出上限为 1024
VL_MODEL=glm-4v-flash
VL_MAX_TOKENS=1024
# VL_API_KEY=
# VL_BASE_URL=
# App 端固定 Bearer Token，改成自己的随机串
BACKEND_SECRET_TOKEN=change-me-to-a-long-random-string
MAX_HISTORY_TURNS=8
REQUEST_TIMEOUT=120
MAX_RETRIES=4
