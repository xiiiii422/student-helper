# 复制成同目录下的 secrets.properties 并填入自己的 Key（该文件已被 .gitignore 排除）。
# build_apk.ps1 会自动读取并以 -P 参数交给 Gradle。
#
# 留空也能构建：只是 APK 里不预埋 Key，装好后在「我的 → 模型服务设置」里粘贴即可。

# 智谱 GLM（open.bigmodel.cn 上申请的 Key，形如 xxxx.xxxxxxxxxxxxxxxx）
glmApiKey=

# DeepSeek（platform.deepseek.com 上申请的 Key，形如 sk-xxxxxxxx）
deepseekApiKey=

# 默认供应商：glm 或 deepseek
defaultProvider=glm
